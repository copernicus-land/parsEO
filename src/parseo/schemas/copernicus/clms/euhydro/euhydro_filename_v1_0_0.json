{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "schema_id": "copernicus:clms:euhydro",
  "schema_version": "1.0.0",
  "status": "current",
  "description": "Copernicus EU Hydro filename per the CLMS Filenaming Framework (extension optional).",
  "fields": {
    "programme": {
      "type": "string",
      "enum": [
        "CLMS"
      ],
      "description": "Constant programme prefix"
    },
    "product": {
      "type": "string",
      "enum": [
        "EUHYDRO"
      ],
      "description": "Product code (EU Hydro)"
    },
    "subtheme": {
      "type": "string",
      "enum": [
        "SUB",
        "NET",
        "DIR"
      ],
      "description": "EU Hydro sub-theme identifier"
    },
    "survey": {
      "type": "string",
      "pattern": "^(?:S\\d{4})$",
      "description": "Temporal coverage token (e.g., S2021)"
    },
    "type": {
      "type": "string",
      "enum": [
        "R",
        "V"
      ],
      "description": "Data type:vector or raster",
      "stac_map": {
        "values": {
          "V": {
            "representation": "vector"
          }
        }
      }
    },
    "resolution": {
      "type": "string",
      "pattern": "^(?:\\d{2,3}m|\\d{2}HA)$",
      "description": "Spatial resolution or minimum mapping unit"
    },
    "tile_id": {
      "description": "Tile identifier in the EEA 10m grid (easting/northing) or two-letter geographic code",
      "oneOf": [
        {
          "title": "INSPIRE ETRS89-LAEA Grid",
          "type": "string",
          "pattern": "^[EW]\\d{2,3}[NS]\\d{2,3}$",
          "description": "Regional LAEA grid tile identifier (2- or 3-digit coordinates)"
        },
        {
          "title": "Geographic code",
          "type": "string",
          "pattern": "^[A-Z]{2}$",
          "description": "Two-letter geographic code used by VLCC vector products"
        }
      ]
    },
    "area_name": {
      "type": "string",
      "pattern": "^[A-Z]+$",
      "description": "Area name identifier (letters)"
    },
    "spatial_coverage": {
      "type": "string",
      "pattern": "^(EU27)$",
      "description": "Optional spatial coverage identifier of the full dataset (e.g, EU27)"
    },
    "epsg_code": {
      "type": "string",
      "pattern": "^\\d{4}$",
      "description": "Bare EPSG code, no zero-padding (e.g., 3035)"
    },
    "production_date": {
      "type": "string",
      "pattern": "^\\d{8}$",
      "description": "Production date (YYYYMMDD)"
    },
    "extension": {
      "type": "string",
      "pattern": "^(gpkg|gdb|fgb|parquet|tif)$",
      "description": "Optional file extension without leading dot"
    },
    "version_revision": {
      "type": "string",
      "pattern": "^V\\d{2}-R\\d{2}$",
      "description": "Single hyphenated version+revision (R=Revision)"
    }
  },
  "template": "{programme}_{product}_{subtheme}_{survey}_{type}{resolution}_{tile_id}_[{spatial_coverage}_]{epsg_code}_{version_revision}_{production_date}[.{extension}]",
  "examples": [
    "CLMS_EUHYDRO_NET_S2026_V10m_EU_3035_V02-R00_20261015.gpkg",
    "CLMS_EUHYDRO_DIR_S2026_V10m_EU_3035_V02-R00_20261015.tif",
    "CLMS_EUHYDRO_SUB_S2021_V05HA_E35N49_EU27_3035_V01-R01_20260211"
  ]
}