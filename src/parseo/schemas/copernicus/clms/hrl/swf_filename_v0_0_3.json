{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "schema_id": "copernicus:clms:hrl:swf",
  "schema_version": "0.0.3",
  "status": "current",
  "stac_version": "1.1.0",
  "stac_extensions": [
    "https://stac-extensions.github.io/raster/v1.0.0/schema.json",
    "https://stac-extensions.github.io/eo/v1.0.0/schema.json"
  ],
  "description": "CLMS High Resolution Layer Small Landscape Features product filename (extension optional).",
  "fields": {
    "programme": {
      "type": "string",
      "enum": [
        "CLMS"
      ],
      "description": "Copernicus Land Monitoring Service programme identifier"
    },
    "product": {
      "type": "string",
      "enum": [
        "HRLSLF"
      ],
      "description": "Product family identifier"
    },
    "variable": {
      "type": "string",
      "pattern": "^[A-Z]{2,4}$",
      "description": "Layer code (e.g., SFW, CM, FM, WVL, SWF, WVCL, SWFC)"
    },
    "temporal_coverage": {
      "type": "string",
      "pattern": "^(?:C\\d{4}-\\d{4}|S\\d{4})$",
      "description": "Temporal coverage token where CYYYY-YYYY captures change layers and SYYYY captures status layers"
    },
    "resolution": {
      "type": "string",
      "pattern": "^(?:R(?:5|10|20|100)m|VEC)$",
      "description": "Spatial resolution"
    },
    "tile_id": {
      "description": "Tile identifier in the EEA 10m grid (easting/northing) or two-letter geographic code",
      "oneOf": [
        {
          "title": "INSPIRE ETRS89-LAEA Grid",
          "type": "string",
          "pattern": "^[EW]\\d{2,3}[NS]\\d{2,3}$",
          "description": "Regional LAEA grid tile identifier (2- or 3-digit coordinates)"
        },
        {
          "title": "Geographic code",
          "type": "string",
          "pattern": "^[A-Z]{2}$",
          "description": "Two-letter geographic code of French overseas department used by SWF raster or vector products"
        }
      ]
    },
    "epsg_code": {
      "type": "string",
      "pattern": "^\\d{5}$",
      "description": "EPSG code of the product grid"
    },
    "version": {
      "type": "string",
      "pattern": "^[Vv]\\d{2}$",
      "description": "Product version"
    },
    "release": {
      "type": "string",
      "pattern": "^[Rr]\\d{2}$",
      "description": "Release identifier"
    },
    "production_date": {
      "type": "string",
      "pattern": "^\\d{8}$",
      "description": "Production date (YYYYMMDD)"
    },
    "extension": {
      "type": "string",
      "enum": [
        "tif",
        "gpkg"
      ],
      "description": "File extension without leading dot"
    }
  },
  "template": "{programme}_{product}_{variable}_{temporal_coverage}_{resolution}_{tile_id}_{epsg_code}_{version}_{release}_{production_date}[.{extension}]",
  "examples": [
    "CLMS_HRLSLF_SFW_S2021_R5m_E34N27_03035_v01_r01_20260521.tif",
    "CLMS_HRLSLF_SFW_S2021_R100m_E36N31_03035_v01_r01_20260521.tif",
    "CLMS_HRLSLF_CM_S2021_R5m_E36N31_03035_v01_r01_20260521.tif",
    "CLMS_HRLSLF_FM_S2021_R5m_E36N31_03035_v01_r01_20260521.tif",
    "CLMS_HRLSLF_WVL_S2018_R5m_E26N17_03035_V01_R02_20260407.tif",
    "CLMS_HRLSLF_SWF_S2021_VEC_E26N17_03035_V01_R02_20260407.gpkg",
    "CLMS_HRLSLF_WVL_S2018_R5m_YT_32738_V02_R02_20250101.tif",
    "CLMS_HRLSLF_WVCL_S2021_R5m_E09N27_03035_V02_R02_20250101.tif"
  ]
}
