{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "schema_id": "copernicus:clms:ua-lcu",
  "schema_version": "1.0.0",
  "status": "current",
  "description": "Copernicus Urban Atlas filename per the CLMS Filenaming Framework (extension optional).",
  "fields": {
    "programme": {
      "type": "string",
      "enum": [
        "CLMS"
      ],
      "description": "Constant programme prefix"
    },
    "product": {
      "type": "string",
      "enum": [
        "UA"
      ],
      "description": "Product code (Urban Atlas)"
    },
    "variable": {
      "type": "string",
      "enum": [
        "LCU",
        "LCUC",
        "BBH",
        "GUA"
      ],
      "description": "Urban Atlas sub-theme"
    },
    "survey": {
      "type": "string",
      "pattern": "^(?:S\\d{4}|C\\d{4}-\\d{4})$",
      "description": "Temporal coverage token (e.g., S2021 or C2018-2021)"
    },
    "type": {
      "type": "string",
      "enum": [
        "V",
        "R"
      ],
      "description": "Data type raster or vector",
      "stac_map": {
        "values": {
          "V": {
            "representation": "vector"
          },
          "R": {
            "representation": "raster"
          }
        }
      }
    },
    "resolution": {
      "type": "string",
      "pattern": "^(\\d{3}ha|\\d{2}m)$",
      "description": "Spatial resolution or minimum mapping unit"
    },
    "area_code": {
      "type": "string",
      "pattern": "^[A-Z]{2}\\d{3}L[A-Za-z0-9]$",
      "description": "Functional urban area (FUA) code"
    },
    "city": {
      "type": "string",
      "pattern": "^[\\w-]+$",
      "description": "City or metropolitan area identifier (letters, digits and hyphen)"
    },
    "epsg_code": {
      "type": "string",
      "pattern": "^\\d{4}$",
      "description": "Bare EPSG code, no zero-padding (e.g., 3035)"
    },
    "production_date": {
      "type": "string",
      "pattern": "^\\d{8}$",
      "description": "Production date (YYYYMMDD)"
    },
    "extension": {
      "type": "string",
      "pattern": "^[A-Za-z0-9]+(?:\\.[A-Za-z0-9]+)?$",
      "description": "Optional file extension without leading dot (allows compound extensions such as gpkg.zip)"
    },
    "version_revision": {
      "type": "string",
      "pattern": "^V\\d{2}-R\\d{2}$",
      "description": "Single hyphenated version+revision (R=Revision)"
    }
  },
  "template": "{programme}_{product}-{variable}_{survey}_{type}{resolution}_{area_code}_{city}_{epsg_code}_{version_revision}_{production_date}[.{extension}]",
  "examples": [
    "CLMS_UA-LCU_S2021_V025ha_DK004L3_AALBORG_3035_V01-R00_20240212",
    "CLMS_UA-LCU_S2018_V025ha_DK004L3_AALBORG_3035_V02-R01_20240212",
    "CLMS_UA-BBH_S2021_R10m_DK004L3_AALBORG_3035_V01-R00_20240212",
    "CLMS_UA-GUA_S2021_V025ha_DK004L3_AALBORG_3035_V01-R11_20240212"
  ]
}