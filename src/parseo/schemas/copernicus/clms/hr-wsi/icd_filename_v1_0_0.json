{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "schema_id": "copernicus:clms:hr-wsi:icd",
  "schema_version": "1.0.0",
  "status": "current",
  "description": "CLMS HR-WSI Ice Cover Duration filename per the CLMS Filenaming Framework (extension optional).",
  "fields": {
    "programme": {
      "type": "string",
      "enum": [
        "CLMS"
      ],
      "description": "Constant programme prefix"
    },
    "product": {
      "type": "string",
      "enum": [
        "ICD"
      ],
      "description": "Product code for Ice Cover Duration"
    },
    "variable": {
      "type": "string",
      "enum": [
        "ICD",
        "ICD-QA",
        "MTD"
      ],
      "description": "Ice Cover Duration variable"
    },
    "sensor": {
      "type": "string",
      "enum": [
        "S2A",
        "S2B",
        "S2C",
        "COMB"
      ],
      "description": "Satellite platform or combination"
    },
    "pixel_spacing": {
      "type": "string",
      "pattern": "^\\d{3}m$",
      "description": "Pixel spacing"
    },
    "tile_id": {
      "title": "MGRS",
      "type": "string",
      "pattern": "^T\\d{2}[C-HJ-NP-X][A-Z]{2}$",
      "description": "MGRS tile identifier"
    },
    "period_start": {
      "type": "string",
      "pattern": "^\\d{8}P\\d+[MYD]$",
      "description": "Aggregation period start"
    },
    "version_revision": {
      "type": "string",
      "pattern": "^V\\d{2}-R\\d{2}$",
      "description": "Hyphenated version+revision"
    },
    "extension": {
      "type": "string",
      "enum": [
        "tif",
        "xml"
      ],
      "description": "File extension"
    }
  },
  "template": "{programme}_{product}-{variable}_{period_start}_{sensor}_{pixel_spacing}_{tile_id}_{version_revision}[.{extension}]",
  "examples": [
    "CLMS_ICD-ICD_20210301P1Y_S2A_020m_T32TNS_V01-R00.tif"
  ]
}