{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "schema_id": "copernicus:clms:hr-wsi:sp",
  "schema_version": "0.0.0",
  "status": "current",
  "description": "CLMS HR-WSI Snow Products filename (extension optional).",
  "fields": {
    "programme": {
      "type": "string",
      "enum": [
        "CLMS"
      ],
      "description": "Constant programme prefix"
    },
    "project": {
      "type": "string",
      "enum": [
        "WSI"
      ],
      "description": "Project"
    },
    "product": {
      "type": "string",
      "enum": [
        "SP"
      ],
      "description": "Product code"
    },
    "pixel_spacing": {
      "type": "string",
      "enum": [
        "020m",
        "060m",
        "100m"
      ],
      "description": "Pixel spacing"
    },
    "tile_id": {
      "description": "Regional LAEA grid tile or MGRS tile identifier",
      "oneOf": [
        {
          "title": "INSPIRE ETRS89-LAEA Grid",
          "type": "string",
          "pattern": "^[EW]\\d{2,3}[NS]\\d{2,3}$",
          "description": "Regional LAEA grid tile identifier (2- or 3-digit coordinates)"
        },
        {
          "title": "MGRS",
          "type": "string",
          "pattern": "^T\\d{2}[C-HJ-NP-X][A-Z]{2}$",
          "description": "MGRS tile identifier (as used by Sentinel-2 products)"
        }
      ]
    },
    "period_start": {
      "type": "string",
      "pattern": "^\\d{8}P1Y$",
      "description": "Aggregation period start"
    },
    "variant": {
      "type": "string",
      "enum": [
        "S2",
        "COMB"
      ],
      "description": "Source mission or combination method"
    },
    "version": {
      "type": "string",
      "pattern": "^V\\d{3}$",
      "description": "Product version"
    },
    "variable": {
      "type": "string",
      "enum": [
        "SCD",
        "SCO",
        "SCM",
        "NOBS",
        "NCSO",
        "NWSO",
        "QAFLAGS",
        "SCD-QA",
        "SCO-QA",
        "SCM-QA",
        "MTD"
      ],
      "description": "File identifier"
    },
    "extension": {
      "type": "string",
      "enum": [
        "tif",
        "xml"
      ],
      "description": "File extension without leading dot"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "variant": {
            "const": "S2"
          }
        },
        "required": [
          "variant"
        ]
      },
      "then": {
        "properties": {
          "pixel_spacing": {
            "enum": [
              "020m",
              "100m"
            ]
          },
          "variable": {
            "enum": [
              "SCD",
              "SCO",
              "SCM",
              "NOBS",
              "QAFLAGS",
              "SCD-QA",
              "SCO-QA",
              "SCM-QA",
              "MTD"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "variant": {
            "const": "COMB"
          }
        },
        "required": [
          "variant"
        ]
      },
      "then": {
        "properties": {
          "pixel_spacing": {
            "enum": [
              "060m",
              "100m"
            ]
          },
          "variable": {
            "enum": [
              "SCD",
              "SCO",
              "SCM",
              "NCSO",
              "NWSO",
              "QAFLAGS",
              "SCD-QA",
              "SCO-QA",
              "SCM-QA",
              "MTD"
            ]
          }
        }
      }
    }
  ],
  "template": "{programme}_{project}_{product}_{pixel_spacing}_{tile_id}_{period_start}_{variant}_{version}_{variable}[.{extension}]",
  "examples": [
    "CLMS_WSI_SP_020m_T38TKL_20200901P1Y_S2_V100_SCD.tif",
    "CLMS_WSI_SP_060m_T38TKL_20200901P1Y_COMB_V100_SCD-QA.tif"
  ]
}
